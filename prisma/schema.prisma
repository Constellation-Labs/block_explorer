  @@index([global_snapshot_hash])
  @@index([source_addr])
  @@index([token_lock_ref])
}

model delegate_stake_withdraw_events {
  hash                 String   @id @db.VarChar
  source_addr          String   @db.VarChar
  stake_ref            String   @unique @db.VarChar
